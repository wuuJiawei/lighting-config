# Server
SERVER_PORT=7086
LIGHTING_CONSOLE_TOKENS=lighting-console-token

# Bundled PostgreSQL (docker-compose.yml)
POSTGRES_DB=lighting_config
POSTGRES_USER=lighting
POSTGRES_PASSWORD=lighting
EXPOSED_DB_PORT=5432
LIGHTING_DB_URL=jdbc:postgresql://lighting-config-db:5432/lighting_config
LIGHTING_DB_DRIVER=org.postgresql.Driver
# 如修改数据库名，请同步调整 LIGHTING_DB_URL 中的数据库段

# External database (docker-compose.external-db.yml)
# LIGHTING_DB_URL=jdbc:postgresql://host.docker.internal:5432/lighting_config
# LIGHTING_DB_DRIVER=org.postgresql.Driver
# LIGHTING_DB_USER=lighting
# LIGHTING_DB_PASSWORD=lighting
